# TinaCMS environment variables
# Get these from https://app.tina.io → your project

# Your TinaCloud Client ID
NEXT_PUBLIC_TINA_CLIENT_ID=

# TinaCloud read token (from project dashboard)
TINA_TOKEN=

# Branch for content (auto-detected from CF Pages env)
# NEXT_PUBLIC_TINA_BRANCH=main

# Set to "true" for local development (connects to local tinacms dev server)
TINA_PUBLIC_IS_LOCAL=true
