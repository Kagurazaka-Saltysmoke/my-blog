---
export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Saltysmoke</title>
    <meta name="description" content={description || title} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="logo">Saltysmoke</a>
        <a href="/admin">Admin</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>© {new Date().getFullYear()} Saltysmoke. Built with Astro + TinaCMS on Cloudflare.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafafa;
    --text: #1a1a1a;
    --muted: #6b7280;
    --accent: #2563eb;
    --border: #e5e7eb;
    --radius: 8px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d0d0d;
      --text: #e5e5e5;
      --muted: #9ca3af;
      --accent: #60a5fa;
      --border: #27272a;
    }
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    -webkit-font-smoothing: antialiased;
  }

  header nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  header a {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
  }
  header .logo {
    font-size: 1.25rem;
    color: var(--accent);
  }
  header a:hover { opacity: 0.7; }

  footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }

  h1 { font-size: 2rem; line-height: 1.3; margin-bottom: 0.5rem; }
  h2 { font-size: 1.5rem; }
  h3 { font-size: 1.2rem; }

  a { color: var(--accent); }
  a:hover { opacity: 0.8; }

  .post-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .post-card:first-of-type { padding-top: 0; }
  .post-card h2 { margin-bottom: 0.25rem; }
  .post-card .meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }
  .post-card .tags {
    margin-top: 0.5rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .post-card .tag {
    background: var(--border);
    color: var(--muted);
    padding: 0.15rem 0.6rem;
    border-radius: 4px;
    font-size: 0.8rem;
  }

  .post-header {
    margin-bottom: 2rem;
  }
  .post-header .meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }
  .post-header .tags {
    margin-top: 0.75rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .post-header .tag {
    background: var(--border);
    color: var(--muted);
    padding: 0.15rem 0.6rem;
    border-radius: 4px;
    font-size: 0.8rem;
  }

  .cover-image {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 2rem;
  }

  /* TinaMarkdown styles */
  .content :global(h1),
  .content :global(h2),
  .content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .content :global(p) {
    margin-bottom: 1.25rem;
  }
  .content :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
  .content :global(pre) {
    background: #1e1e1e;
    color: #d4d4d4;
    padding: 1rem;
    border-radius: var(--radius);
    overflow-x: auto;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
  }
  .content :global(code) {
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 0.9em;
  }
  .content :global(:not(pre) > code) {
    background: var(--border);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .content :global(blockquote) {
    border-left: 3px solid var(--accent);
    margin: 1.25rem 0;
    padding-left: 1rem;
    color: var(--muted);
    font-style: italic;
  }
  .content :global(ul),
  .content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .content :global(li) {
    margin-bottom: 0.5rem;
  }
  .content :global(img) {
    max-width: 100%;
    border-radius: var(--radius);
  }
  .content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .back-link {
    display: inline-block;
    margin-top: 2rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
